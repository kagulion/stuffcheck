---
import { cn } from '@lib/utils';

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  class?: string;
};

const {
  href,
  external,
  underline = true,
  class: className,
  ...rest
} = Astro.props;
---

<a
  href={href}
  target={external ? '_blank' : '_self'}
  rel={external ? 'noopener noreferrer' : undefined}
  class={cn(
    'inline-block text-zinc-900 dark:text-zinc-100 hover:text-zinc-600 dark:hover:text-zinc-300 decoration-zinc-300 dark:decoration-zinc-700 hover:decoration-zinc-900 dark:hover:decoration-zinc-100 transition-colors duration-150 ease-in-out',
    underline && 'underline underline-offset-4',
    className
  )}
  {...rest}
>
  <slot />
</a>
