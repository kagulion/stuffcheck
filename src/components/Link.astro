---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  class?: string;
}

const { href, external, underline = true, class: className, ...rest } = Astro.props;
---

<a 
  href={href} 
  target={ external ? "_blank" : "_self" } 
  class={cn("inline-block text-zinc-700 dark:text-zinc-300 hover:text-sky-600 dark:hover:text-sky-400 decoration-zinc-300 dark:decoration-zinc-700 hover:decoration-sky-500 dark:hover:decoration-sky-400 transition-colors duration-200 ease-in-out", underline && "underline underline-offset-4", className)}
  {...rest}>
  <slot/>
</a>
