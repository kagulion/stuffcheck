---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
  showDate?: boolean;
}

const { entry, showDate = false } = Astro.props;
---

<a 
  href={`/${entry.collection}/${entry.slug}`} 
  class="group block -mx-3 px-3 py-2.5 rounded-lg transition-colors duration-150 ease-out hover:bg-zinc-100 dark:hover:bg-zinc-800/50"
>
  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
    <div class="font-medium text-[15px] text-zinc-900 dark:text-zinc-100 group-hover:text-black dark:group-hover:text-white transition-colors">
      {entry.data.title}
    </div>
    {showDate && 'date' in entry.data && (
      <div class="text-xs text-zinc-400 dark:text-zinc-500 shrink-0 font-normal">
        {new Date(entry.data.date).toLocaleDateString('ru-RU', { month: 'short', day: 'numeric', year: 'numeric' })}
      </div>
    )}
  </div>
  {entry.data.description && (
    <p class="text-sm text-zinc-500 dark:text-zinc-400 font-normal mt-0.5 line-clamp-2 leading-relaxed">
      {entry.data.description}
    </p>
  )}
</a>

