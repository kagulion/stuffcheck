---
import type { CollectionEntry } from 'astro:content';

type Props = {
  entry: CollectionEntry<'blog'> | CollectionEntry<'projects'>;
  showDate?: boolean;
};

const { entry, showDate = false } = Astro.props;
---

<a
  href={`/${entry.collection}/${entry.slug}`}
  class="group -mx-3 block rounded-lg px-3 py-2.5 transition-colors duration-150 ease-out hover:bg-zinc-100 dark:hover:bg-zinc-800/50"
>
  <div
    class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between"
  >
    <div
      class="text-[15px] font-medium text-zinc-900 transition-colors group-hover:text-black dark:text-zinc-100 dark:group-hover:text-white"
    >
      {entry.data.title}
    </div>
    {
      showDate && 'date' in entry.data && (
        <div class="shrink-0 text-xs font-normal text-zinc-400 dark:text-zinc-500">
          {new Date(entry.data.date).toLocaleDateString('ru-RU', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
          })}
        </div>
      )
    }
  </div>
  {
    entry.data.description && (
      <p class="mt-0.5 line-clamp-2 text-sm font-normal leading-relaxed text-zinc-500 dark:text-zinc-400">
        {entry.data.description}
      </p>
    )
  }
</a>
