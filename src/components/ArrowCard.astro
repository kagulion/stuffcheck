---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
}

const { entry } = Astro.props;
---

<a href={`/${entry.collection}/${entry.slug}`} class="relative group flex flex-nowrap py-3.5 px-4 pr-10 rounded-xl border border-zinc-200/80 dark:border-zinc-700/60 bg-zinc-100/40 dark:bg-zinc-800/40 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 hover:border-zinc-300 dark:hover:border-zinc-600 transition-all duration-200 ease-in-out">
  <div class="flex flex-col flex-1 truncate">
    <div class="font-medium text-zinc-900 dark:text-zinc-100 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors duration-200">
      {entry.data.title}
    </div>
    <div class="text-sm text-zinc-500 dark:text-zinc-400 truncate mt-0.5">
      {entry.data.description}
    </div>
  </div>
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    viewBox="0 0 24 24"
    class="absolute top-1/2 right-3 -translate-y-1/2 size-4 stroke-2 fill-none stroke-zinc-400 dark:stroke-zinc-500 group-hover:stroke-sky-600 dark:group-hover:stroke-sky-400 transition-colors duration-200">
    <line x1="5" y1="12" x2="19" y2="12" class="translate-x-2 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-200 ease-in-out" />
    <polyline points="12 5 19 12 12 19" class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-200 ease-in-out" />
  </svg>
</a>
