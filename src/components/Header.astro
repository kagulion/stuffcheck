---
import { SITE } from '@consts';

type Props = {
  class?: string;
};

const { class: className } = Astro.props;
---

<header class={`animate space-y-2.5 mb-16 sm:mb-24 ${className || ''}`}>
  <a href="/" class="inline-block group">
    <h1
      class="font-serif text-3xl sm:text-4xl text-zinc-900 dark:text-zinc-100 font-normal tracking-tight group-hover:text-zinc-600 dark:group-hover:text-zinc-300 transition-colors"
    >
      {SITE.NAME}
    </h1>
  </a>
  <p
    class="text-xs sm:text-sm leading-relaxed text-zinc-500 dark:text-zinc-400 font-normal"
  >
    Блог о практическом применении AI-агентов в кодовой базе, системном дизайне,
    инструментах разработчика и создании быстрых минималистичных веб-приложений.
  </p>
</header>
