---
import { SITE } from '@consts';

type Props = {
  class?: string;
};

const { class: className } = Astro.props;
---

<header class={`animate space-y-2.5 mb-16 sm:mb-24 ${className || ''}`}>
  <a href="/" class="group inline-block">
    <h1
      class="font-serif text-3xl font-normal tracking-tight text-zinc-900 transition-colors group-hover:text-zinc-600 dark:text-zinc-100 dark:group-hover:text-zinc-300 sm:text-4xl"
    >
      {SITE.NAME}
    </h1>
  </a>
  <p
    class="text-xs font-normal leading-relaxed text-zinc-600 dark:text-zinc-400 sm:text-sm"
  >
    Блог о практическом применении AI-агентов в кодовой базе, системном дизайне,
    инструментах разработчика и создании быстрых минималистичных веб-приложений.
  </p>
</header>
