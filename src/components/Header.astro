---
import Container from '@components/Container.astro';
import { SITE } from '@consts';
---

<header>
  <Container>
    <div class="flex items-center justify-between">
      <a href="/" class="font-medium text-[15px] text-zinc-900 dark:text-zinc-100 hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors">
        {SITE.NAME}
      </a>
      <nav class="flex items-center gap-5 text-sm">
        <a href="/blog" class="text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors">
          Блог
        </a>
      </nav>
    </div>
  </Container>
</header>

