---
import { getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import Container from '@components/Container.astro';
import Header from '@components/Header.astro';
import ArrowCard from '@components/ArrowCard.astro';
import { PROJECTS } from '@consts';

const projects = (await getCollection('projects'))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <div>
      <Header />
      <div class="space-y-10 sm:space-y-12">
        <div class="animate space-y-1">
          <h1
            class="text-[17px] font-medium tracking-[-0.01em] text-zinc-900 dark:text-zinc-100"
          >
            Проекты
          </h1>
          <p class="text-sm font-normal text-zinc-500 dark:text-zinc-400">
            Избранные разработки и открытый исходный код
          </p>
        </div>
        <ul class="animate flex flex-col gap-0.5">
          {
            projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</PageLayout>
