---
import { type CollectionEntry, getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import Container from '@components/Container.astro';
import FormattedDate from '@components/FormattedDate.astro';
import { readingTime } from '@lib/utils';
import BackToPrev from '@components/BackToPrev.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await post.render();
---

<PageLayout title={post.data.title} description={post.data.description}>
  <Container>
    <div class="animate">
      <BackToPrev href="/blog"> Назад </BackToPrev>
    </div>
    <div class="my-8 sm:my-10 space-y-3 pb-8 border-b border-zinc-200/80 dark:border-zinc-800/80">
      <div class="animate flex items-center gap-3 text-sm text-zinc-500 dark:text-zinc-400 font-medium">
        <FormattedDate date={post.data.date} />
        <div class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono bg-zinc-200/60 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 border border-zinc-300/50 dark:border-zinc-700/60">
          {readingTime(post.body)}
        </div>
      </div>
      <h1
        class="animate text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50 leading-tight"
      >
        {post.data.title}
      </h1>
      {
        post.data.description && (
          <p class="animate text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal">
            {post.data.description}
          </p>
        )
      }
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
