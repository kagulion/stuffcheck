---
import { type CollectionEntry, getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import Container from '@components/Container.astro';
import Header from '@components/Header.astro';
import FormattedDate from '@components/FormattedDate.astro';
import { readingTime } from '@lib/utils';
import BackToPrev from '@components/BackToPrev.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await post.render();
---

<PageLayout title={post.data.title} description={post.data.description}>
  <Container>
    <Header />
    <div class="animate mb-8">
      <BackToPrev href="/blog"> Все статьи </BackToPrev>
    </div>
    <div
      class="mb-8 space-y-3 border-b border-zinc-100 pb-8 dark:border-zinc-800/60"
    >
      <div
        class="animate flex items-center gap-2 text-xs font-normal text-zinc-400 dark:text-zinc-500"
      >
        <FormattedDate date={post.data.date} />
        <span>·</span>
        <span>{readingTime(post.body)}</span>
      </div>
      <h1
        class="animate font-serif text-2xl font-semibold leading-snug tracking-[-0.015em] text-zinc-900 dark:text-zinc-100 sm:text-3xl"
      >
        {post.data.title}
      </h1>
      {
        post.data.description && (
          <p class="animate text-[15px] font-normal leading-relaxed text-zinc-500 dark:text-zinc-400 sm:text-base">
            {post.data.description}
          </p>
        )
      }
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
