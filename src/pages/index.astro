---
import { getCollection } from 'astro:content';
import Container from '@components/Container.astro';
import PageLayout from '@layouts/PageLayout.astro';
import ArrowCard from '@components/ArrowCard.astro';
import Link from '@components/Link.astro';
import { SITE, HOME } from '@consts';

const blog = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="animate mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50 flex items-center gap-2">
        Привет <span class="text-2xl inline-block animate-bounce">👋🏻</span>
      </h1>
      <p class="mt-2 text-zinc-600 dark:text-zinc-400 text-base sm:text-lg">
        Блог о технологиях, архитектуре и AI-разработке.
      </p>
    </div>

    <div class="space-y-12">
      <!-- Последние посты в блоге -->
      <section class="animate space-y-5">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="text-lg font-semibold tracking-tight text-zinc-950 dark:text-zinc-50">
            Последние записи
          </h2>
          <Link href="/blog" class="text-sm font-medium"> Смотреть все &rarr; </Link>
        </div>
        <ul class="flex flex-col gap-3.5">
          {
            blog.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))
          }
        </ul>
      </section>

