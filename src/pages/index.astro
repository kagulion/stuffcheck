---
import { getCollection } from 'astro:content';
import Container from '@components/Container.astro';
import PageLayout from '@layouts/PageLayout.astro';
import ArrowCard from '@components/ArrowCard.astro';
import { SITE, HOME } from '@consts';

const blog = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-12 sm:space-y-14">
      <!-- Hero Section -->
      <section class="animate space-y-2.5">
        <h1 class="font-serif text-3xl sm:text-4xl text-zinc-900 dark:text-zinc-100 font-normal tracking-tight">
          {SITE.NAME}
        </h1>
        <p class="text-[15px] sm:text-base leading-relaxed text-zinc-500 dark:text-zinc-400 font-normal">
          Блог о практическом применении AI-агентов в кодовой базе, системном дизайне, инструментах разработчика и создании быстрых минималистичных веб-приложений.
        </p>
      </section>

      <!-- Recent Posts Section -->
      <section class="animate space-y-3">
        <div class="flex items-baseline justify-between mb-1">
          <h2 class="text-xs font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
            Статьи
          </h2>
          <a
            href="/blog"
            class="text-xs text-zinc-400 hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-zinc-100 transition-colors"
          >
            Все публикации &rarr;
          </a>
        </div>
        <ul class="flex flex-col gap-0.5">
          {
            blog.map((post) => (
              <li>
                <ArrowCard entry={post} showDate={true} />
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>

