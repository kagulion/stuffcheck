---
import { getCollection } from 'astro:content';
import Container from '@components/Container.astro';
import PageLayout from '@layouts/PageLayout.astro';
import Header from '@components/Header.astro';
import ArrowCard from '@components/ArrowCard.astro';
import { HOME } from '@consts';

const blog = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div>
      <Header />

      <!-- Recent Posts Section -->
      <section class="animate space-y-3">
        <div class="flex items-baseline justify-between mb-1">
          <h2 class="text-xs tracking-wider text-zinc-400 dark:text-zinc-500">
            Статьи
          </h2>
          <a
            href="/blog"
            class="text-xs text-zinc-400 hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-zinc-100 transition-colors"
          >
            Все публикации &rarr;
          </a>
        </div>
        <ul class="flex flex-col gap-0.5">
          {
            blog.map((post) => (
              <li>
                <ArrowCard entry={post} showDate={true} />
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
